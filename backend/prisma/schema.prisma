// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------
// SYSTEM & USERS
// ----------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("MEMBER")
  workloadLevel String   @default("NORMAL")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // Soft delete

  projectsManaged Project[]      @relation("ProjectManager")
  taskAssignments TaskAssignee[] 
  activityLogs    ActivityLog[]
}

// ----------------------------------------------------------------------
// CORE PROJECTS
// ----------------------------------------------------------------------

model Project {
  id               String        @id @default(uuid())
  name             String
  clientName       String
  projectType      String
  startDate        DateTime
  deadline         DateTime
  status           String        @default("PLANNING")
  overallProgress  Float         @default(0.0) // 0 to 100
  
  managerId        String
  manager          User          @relation("ProjectManager", fields: [managerId], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?     // Soft delete

  divisions        Division[]
  activityLogs     ActivityLog[]
}

// ----------------------------------------------------------------------
// DIVISION WORKFLOW ENGINE
// ----------------------------------------------------------------------
// E.g., Strategy, Creative, Design, Video Production, Editing

model Division {
  id             String    @id @default(uuid())
  name           String
  progressWeight Float     // e.g. 15 for 15% out of 100% total project
  overallProgress Float    @default(0.0) // 0 to 100

  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks          Task[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft delete
}

// ----------------------------------------------------------------------
// TASK & ASSIGNMENT ENGINE
// ----------------------------------------------------------------------

model Task {
  id             String      @id @default(uuid())
  title          String
  description    String?
  priority       String      @default("MEDIUM")
  deadline       DateTime?
  status         String      @default("TODO")
  revisionCount  Int         @default(0)
  approvalState  Boolean     @default(false)
  
  divisionId     String
  division       Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  dependencyId   String?     // A task cannot start before dependency is completed
  dependency     Task?       @relation("TaskDependency", fields: [dependencyId], references: [id])
  dependents     Task[]      @relation("TaskDependency")
  
  assignees      TaskAssignee[]
  subtasks       Subtask[]
  attachments    Attachment[]
  revisionLogs   RevisionLog[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?   // Soft delete
}

model TaskAssignee {
  taskId String
  userId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Subtask {
  id        String   @id @default(uuid())
  title     String
  isDone    Boolean  @default(false)

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String?

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------
// REVISION MANAGEMENT SYSTEM
// ----------------------------------------------------------------------

model RevisionLog {
  id              String   @id @default(uuid())
  revisionCounter Int
  notes           String
  
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
}

// ----------------------------------------------------------------------
// PROJECT TEMPLATE ENGINE
// ----------------------------------------------------------------------

model ProjectTemplate {
  id        String             @id @default(uuid())
  name      String             // e.g. "Standard Video Production"
  version   Int                @default(1)
  
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  divisions DivisionTemplate[]
}

model DivisionTemplate {
  id                String          @id @default(uuid())
  name              String
  progressWeight    Float
  
  projectTemplateId String
  projectTemplate   ProjectTemplate @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)

  tasks             TaskTemplate[]
}

model TaskTemplate {
  id                 String           @id @default(uuid())
  title              String
  description        String?
  priority           String         @default("MEDIUM")
  dayOffset          Int              // Days offset from project start date
  
  divisionTemplateId String
  divisionTemplate   DivisionTemplate @relation(fields: [divisionTemplateId], references: [id], onDelete: Cascade)

  subtasks           SubtaskTemplate[]
}

model SubtaskTemplate {
  id             String       @id @default(uuid())
  title          String
  
  taskTemplateId String
  taskTemplate   TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------
// AUDIT LOGS (SYSTEM SAFEGUARDS)
// ----------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "TASK_COMPLETED", "REVISION_REQUESTED"
  resourceId String?  // ID of the task/project affected
  
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])

  createdAt  DateTime @default(now())
}
